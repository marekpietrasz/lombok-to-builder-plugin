# Copy this file to `publish.env` (git-ignored) and fill in your values.
# DO NOT commit publish.env or your key/cert files.

# JetBrains Marketplace permanent token: https://plugins.jetbrains.com/author/me/tokens
PUBLISH_TOKEN=perm:replace-me

# --- Plugin signing material (Marketplace requires signed uploads) ---
# Option A: point at files (recommended).
PRIVATE_KEY_FILE=/absolute/path/to/private_encrypted.pem
CERTIFICATE_CHAIN_FILE=/absolute/path/to/chain.crt
PRIVATE_KEY_PASSWORD=your-key-passphrase

# Option B (instead of *_FILE): paste PEM contents inline. Multi-line values must be quoted:
# PRIVATE_KEY="-----BEGIN ENCRYPTED PRIVATE KEY-----
# ...
# -----END ENCRYPTED PRIVATE KEY-----"
# CERTIFICATE_CHAIN="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Gradle must run on JDK 17-21 (the default JDK 25 can't run Gradle 8.10.2).
PUBLISH_JAVA_HOME=/Users/marek/.sdkman/candidates/java/21.0.8-tem
